---
import RatioWrap from 'src/components/basic/RatioWrap.astro';
import Layout from '../layouts/Layout.astro';
import HomeHero from 'src/components/HomeHero.astro'

---

<Layout title="Крипто школа" description="Крипто школа">
	<HomeHero container="split">
		<div class="ratio-wrap ratio-wrap_cover home-hero__video" slot="media" data-component="video">
			<video src="https://kalikso.pl/qumen-kitchen/video.mp4"></video>
			<button type="button" class="home-hero__video-btn btn">
				<div class="btn__icon icon-play-triangle-right"></div>
				<div class="btn__label btn__label_hidden">Play</div>
			</button>
		</div>
	</HomeHero>
</Layout>